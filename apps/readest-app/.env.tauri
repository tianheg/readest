NEXT_PUBLIC_APP_PLATFORM=tauri

DBUS_ID=com.bilingify.readest

# Fork build: unlock upstream's premium gates without a subscription (see
# apps/readest-app/src/utils/access.ts) — this fork has no store to buy from.
NEXT_PUBLIC_SELF_HOSTED=true

# No Next.js/Vercel build telemetry from this machine either.
NEXT_TELEMETRY_DISABLED=1

# Deliberately NOT set (see the fork plan): SENTRY_DSN, NEXT_PUBLIC_POSTHOG_KEY,
# NEXT_PUBLIC_DEFAULT_*_BASE64, SUPABASE_* — no telemetry, no crash reporting,
# no vendor backend.
